# development | production. Production refuses to start on insecure
# defaults (see check_production_readiness in app/config.py).
ENVIRONMENT=development

# Google Gemini API key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use for code generation
GEMINI_MODEL=gemini-3.5-flash-lite

# Sandbox limits. Memory is enforced with RLIMIT_DATA on POSIX and a Job
# Object on Windows -- both cap memory actually used, so size this against
# peak RSS; output is the largest result the sandbox may return.
# See SECURITY.md for the full threat model.
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=1024
SANDBOX_OUTPUT_MB=8
MAX_UPLOAD_MB=25

# Verify each answer (invariant checks + LLM critic pass -> confidence level).
# Costs one extra LLM call per question. Set false to disable.
VERIFY_ANSWERS=true

# Auth / DB. Managed Postgres URLs (postgres://...) are rewritten to the
# psycopg driver automatically.
DATABASE_URL=sqlite:///./app.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call the API. No trailing slash.
CORS_ORIGINS=http://localhost:5173

# Storage: "local" (default) or "s3"
STORAGE_BACKEND=local
# When STORAGE_BACKEND=s3:
S3_BUCKET=
S3_ENDPOINT_URL=          # e.g. https://<project>.supabase.co/storage/v1/s3  (blank for AWS)
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via standard env vars
